# Planeta Susu no necesita secretos para publicar.
# El progreso vive en el navegador (localStorage).

VITE_AUTH_ENABLED=false

# Clave con la que wiwo.doom publica en este sitio.
# Sin esto el endpoint de escritura del contrato existe pero rechaza todo, y el
# manifest anuncia write:false, así que el orquestador no ofrece este destino.
# La misma clave se carga en doom, en la página conectada.
WIWO_WRITE_TOKEN=
